# Variables de docker-compose.yml. En Dokploy se pegan en la pestaña
# Environment (Dokploy escribe con ellas el .env del despliegue); en local, se
# copia este fichero a .env. El .env NO se sube: lleva el secreto de sesión.
# Detalle de cada una: despliegue/docker/LEEME.md

# ---- Obligatorias: sin ellas el compose no arranca ----

# El nombre público, SIN https:// y sin barra final. Tiene que ser el mismo que
# apunta al servidor en el DNS (o en Cloudflare): con él se enruta en Traefik,
# se pide el certificado y se valida el origen del login.
DOMINIO=estudio.midominio.com

# Firma las sesiones del acceso. Mínimo 32 caracteres; si cambia, se cierran
# todas las sesiones. Se genera con: openssl rand -hex 48
SESSION_SECRET=

# ---- Opcionales ----

# Planos que se renderizan a la vez. El número de hilos del servidor, máx. 16
# (medido en 8 hilos: 4 → 6,75 fotogramas/s, 8 → 10,40).
ESTUDIO_LOTES=4

# Orígenes admitidos por el login, separados por comas. Por defecto
# https://$DOMINIO. Si se entra también por `www.` u otro nombre, van aquí o el
# login contesta «Origen no permitido».
# APP_ORIGENES=https://estudio.midominio.com,https://www.estudio.midominio.com

# La cookie de sesión va `secure`. Solo se baja a false para probar sin HTTPS:
# con ella en true y sin certificado, se entra y se vuelve a la pantalla de acceso.
# SECURE_COOKIES=true

# A 1, el build se para si no se pueden bajar las fuentes de Microsoft en vez
# de seguir con DejaVu (textos con otra letra, pero cuadrados).
# EXIGIR_FUENTES_MS=0

# Solo para el enlace de «he olvidado la contraseña» en un VPS de Hostinger.
# HOSTINGER_VPS_ID=
